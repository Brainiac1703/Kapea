<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Orígenes de paquetes del repositorio.

    El <clear /> descarta los orígenes configurados a nivel de máquina o de
    usuario y deja solo nuget.org. Así la restauración dentro del contenedor es
    idéntica a la de cualquier equipo, y se cierra la puerta a la confusión de
    dependencias: con un único origen público, un paquete homónimo publicado en
    nuget.org no puede colarse en lugar de uno interno.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>

  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
