# Copia este fichero a .env y ajusta los valores.
# .env está excluido del repositorio.

# --- SQL Server de desarrollo ---------------------------------------------
# Obligatoria. SQL Server exige al menos 8 caracteres con mayúsculas,
# minúsculas, dígitos y símbolos, o el contenedor no arranca.
MSSQL_SA_PASSWORD=Desarrollo.2026!

# --- Identidad ------------------------------------------------------------
# Opcional. Sin cliente de Google, la API arranca con autenticación de
# desarrollo y atribuye todo al usuario de abajo. Solo funciona en Development:
# fuera de él la API se niega a arrancar sin identidad configurada.
#
# Las credenciales se sacan de la consola de Google Cloud, en Credenciales ->
# ID de cliente de OAuth, con la URI de redirección
# http://localhost:8082/signin-google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Identificador con el que se importó todo antes de que Kapea tuviera usuarios.
# El primero que inicie sesión adopta esos datos. No hace falta tocarlo.
LEGACY_OWNER_ID=00000000-0000-0000-0000-000000000001

# --- Secretos de los brokers ----------------------------------------------
# Opcional. Sin Key Vault se usa el almacén de desarrollo, un fichero de User
# Secrets dentro de un volumen del contenedor. Guarda en claro, como todo User
# Secrets: no pongas aquí claves de una cuenta con dinero real.
#
#   https://<nombre-del-vault>.vault.azure.net/
KEYVAULT_URI=

# --- Sincronización -------------------------------------------------------
# Cada cuánto se sincroniza con Kraken y Bit2Me. Corto en desarrollo para no
# esperar seis horas a ver si funciona.
SYNC_INTERVAL=00:15:00

# --- Observabilidad -------------------------------------------------------
# Opcional. Sin cadena de conexión, la telemetría no se registra y la
# aplicación arranca igual.
APPLICATIONINSIGHTS_CONNECTION_STRING=

# --- Puertos --------------------------------------------------------------
# SQL Server no usa 1433 por omisión para no chocar con una instancia local ni
# con el contenedor de otro proyecto que ya lo tenga cogido.
API_PORT=8082
SQLSERVER_PORT=14331

# Con Google configurado, pon true para conservar además el acceso como usuario de
# desarrollo. Solo vale en desarrollo; fuera de ahí la API lo ignora.
DEV_USER_ENABLED=false

# Propuesta automática del mapeo de un formato desconocido. Todo opcional: sin esto
# el mapeo se hace a mano y la importación funciona igual.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_KEY=
