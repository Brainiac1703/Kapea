<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Extensions.AspNetCore.Configuration.Secrets" />
    <PackageReference Include="Azure.Extensions.AspNetCore.DataProtection.Blobs" />
    <PackageReference Include="Azure.Extensions.AspNetCore.DataProtection.Keys" />
    <!-- Azure.Core declara un DefaultAzureCredential con el mismo nombre completo que
         Azure.Identity. El alias desambigua, igual que en Kapea.Infrastructure. -->
    <PackageReference Include="Azure.Identity" Aliases="AzureIdentity" />
    <PackageReference Include="Azure.Security.KeyVault.Secrets" />
    <PackageReference Include="Microsoft.ApplicationInsights.AspNetCore" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Google" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Kapea.Application\Kapea.Application.csproj" />
    <ProjectReference Include="..\Kapea.Infrastructure\Kapea.Infrastructure.csproj" />
    <ProjectReference Include="..\Kapea.Shared\Kapea.Shared.csproj" />
    <ProjectReference Include="..\Kapea.Client\Kapea.Client.csproj" />
  </ItemGroup>

</Project>
