@* Las tres capas del logo. El color sale de la hoja de estilos para seguir al modo
   oscuro sin tocar el dibujo. *@
<svg class="brand-mark" width="@Size" height="@Size" viewBox="0 0 32 32" aria-hidden="true">
    <rect x="3" y="21" width="26" height="6" rx="2"></rect>
    <rect x="10" y="13" width="19" height="6" rx="2" opacity="0.78"></rect>
    <rect x="17" y="5" width="12" height="6" rx="2" opacity="0.56"></rect>
</svg>

@code {
    [Parameter]
    public int Size { get; set; } = 26;
}
