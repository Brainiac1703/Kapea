@using System.Globalization

@* Se dibuja en SVG y no con una librería: son líneas, y así el formato de los importes,
   las fechas y el tema salen del mismo sitio que el resto de la aplicación. *@
@if (Lines.Count == 0 || _bounds is null)
{
    <FluentMessageBar Intent="MessageIntent.Info">@Ui["Charts_Empty"]</FluentMessageBar>
}
else
{
    <div class="chart">
        <svg viewBox="@($"0 0 {Width} {Height}")" preserveAspectRatio="none" role="img"
             aria-label="@Title" @onmouseleave="OnLeave">

            @* Rejilla horizontal con su valor, para poder leer una altura sin contar. *@
            @foreach (var line in _bounds.GridLines)
            {
                <line x1="@Left" y1="@N(Y(line))" x2="@(Width - Right)" y2="@N(Y(line))" class="chart-grid" />
                @Label(4, Y(line) - 4, Format.Compact(line), "start")
            }

            @if (Stacked)
            {
                @* Apiladas: cada clase se dibuja sobre la anterior, y la altura total es
                   el patrimonio. Superpuestas se taparían y no se vería el reparto. *@
                @foreach (var area in Areas())
                {
                    <polygon points="@area.Points" class="@area.Series" fill-opacity="0.75" />
                }
            }
            else
            {
                @if (AsBand)
                {
                    @* Demasiadas velas para que se distingan: una banda dice por dónde
                       anduvo el precio, y la línea del cierre va encima. *@
                    <polygon points="@Band()" class="chart-range" />
                }

                @if (AsCandles)
                {
                    @foreach (var candle in Candles!)
                    {
                        <line x1="@N(X(candle.Date))" y1="@N(Y(candle.High))"
                              x2="@N(X(candle.Date))" y2="@N(Y(candle.Low))"
                              class="@(candle.Rose ? "chart-candle-up" : "chart-candle-down")" stroke-width="1" />

                        @* Un cuerpo de altura cero no se vería, y un día que abre y
                           cierra igual sí ocurrió: se dibuja como una raya. *@
                        <rect x="@N(X(candle.Date) - (CandleWidth / 2))" y="@N(Body(candle).Top)"
                              width="@N(CandleWidth)" height="@N(Body(candle).Height)"
                              class="@(candle.Rose ? "chart-candle-up" : "chart-candle-down")" />
                    }
                }

                @foreach (var line in Lines)
                {
                    @* Cada tramo sin huecos va aparte: unir por encima de un día sin
                       precio dibujaría una recta que nadie cotizó. *@
                    @foreach (var segment in Segments(line))
                    {
                        <polyline points="@segment" fill="none" class="@line.Series"
                                  stroke-width="2" stroke-dasharray="@(line.Dashed ? "6 4" : null)" />
                    }
                }
            }

            @if (_hover is { } hover)
            {
                <line x1="@N(X(hover))" y1="0" x2="@N(X(hover))" y2="@(Height - Bottom)" class="chart-cursor" />
            }

            @* Una banda invisible por tramo, en las mismas coordenadas del dibujo. El
               ratón llega en píxeles de pantalla y el dibujo se estira, así que
               calcular la fecha a partir de la posición señalaría otro día en cuanto
               cambiara el tamaño de la ventana. *@
            @foreach (var band in _bounds.Bands(Left, Width - Right, Dates))
            {
                <rect x="@N(band.X)" y="0" width="@N(band.Width)" height="@(Height - Bottom)"
                      fill="transparent" @onmouseover="@(() => _hover = band.Date)" />
            }

            @Label(Left, Height - 4, Moment(_bounds.From), "start")
            @Label(Width - Right, Height - 4, Moment(_bounds.To), "end")
        </svg>

        @if (_hover is { } day)
        {
            <div class="chart-readout">
                <span class="chart-readout-date">@Moment(day)</span>
                @foreach (var line in Lines)
                {
                    <span class="chart-readout-line">
                        <span class="chart-readout-dot @line.Series"></span>
                        @line.Name
                        <strong>@Reading(line, day)</strong>
                    </span>
                }
            </div>
        }
    </div>
}

@code {
    private const int Width = 1000;
    private const int Height = 320;
    private const int Left = 56;
    private const int Right = 8;
    private const int Bottom = 20;

    /// <summary>Aire por arriba: sin él, la etiqueta del valor más alto se corta.</summary>
    private const int Top = 18;

    private Bounds? _bounds;
    private DateOnly? _hover;

    [Parameter]
    [EditorRequired]
    public required IReadOnlyList<ChartLine> Lines { get; set; } = [];

    /// <summary>Descripción de la gráfica para quien no la ve.</summary>
    [Parameter]
    [EditorRequired]
    public required string Title { get; set; }

    /// <summary>Cómo se lee un valor: importe en euros por omisión.</summary>
    [Parameter]
    public Func<decimal, string>? Formatter { get; set; }

    /// <summary>Apila las series una sobre otra en lugar de superponerlas.</summary>
    [Parameter]
    public bool Stacked { get; set; }

    /// <summary>
    /// El recorrido de cada tramo, cuando se conoce.
    /// </summary>
    /// <remarks>
    /// Con pocos tramos se dibujan velas. Con muchos, la vela se queda en una línea
    /// vertical de un píxel y no aporta: se dibuja una banda que marca por dónde anduvo,
    /// con la línea del cierre encima. Sin recorrido, la línea sola.
    /// </remarks>
    [Parameter]
    public IReadOnlyList<ChartCandle>? Candles { get; set; }

    /// <summary>
    /// A partir de cuántos tramos la vela deja de aportar.
    /// </summary>
    /// <remarks>
    /// El dibujo mide mil unidades de ancho: con más de ciento ochenta velas, cada una
    /// baja de cinco unidades y el cuerpo desaparece.
    /// </remarks>
    private const int MaxCandles = 180;

    /// <summary>Se dibujan velas: hay recorrido y caben.</summary>
    private bool AsCandles => Candles is { Count: > 0 } and { Count: <= MaxCandles } && !Stacked;

    /// <summary>Se dibuja la banda del recorrido bajo la línea: hay recorrido y no caben velas.</summary>
    private bool AsBand => Candles is { Count: > MaxCandles } && !Stacked;

    protected override void OnParametersSet() =>
        _bounds = Bounds.Of(Stacked ? Stack(Lines) : Lines, Candles);

    /// <summary>
    /// Las series acumuladas una sobre otra.
    /// </summary>
    /// <remarks>
    /// Los extremos del dibujo se calculan sobre lo apilado: si se tomaran de las series
    /// sueltas, la pila más alta se saldría por arriba.
    /// </remarks>
    private static IReadOnlyList<ChartLine> Stack(IReadOnlyList<ChartLine> lines)
    {
        var running = new Dictionary<DateOnly, decimal>();
        var stacked = new List<ChartLine>();

        foreach (var line in lines)
        {
            var points = new List<ChartPoint>();

            foreach (var point in line.Points)
            {
                var below = running.GetValueOrDefault(point.Date, 0m);
                var total = below + (point.Value ?? 0m);

                running[point.Date] = total;
                points.Add(new ChartPoint(point.Date, point.Value is null ? null : total));
            }

            stacked.Add(line with { Points = points });
        }

        return stacked;
    }

    /// <summary>Cada clase como un área entre su altura acumulada y la de la anterior.</summary>
    private IEnumerable<(string Points, string Series)> Areas()
    {
        var stacked = Stack(Lines);

        for (var index = stacked.Count - 1; index >= 0; index--)
        {
            var top = stacked[index].Points.Where(point => point.Value is not null).OrderBy(point => point.Date).ToList();

            if (top.Count < 2)
            {
                continue;
            }

            var points = top
                .Select(point => string.Create(CultureInfo.InvariantCulture, $"{N(X(point.Date))},{N(Y(point.Value!.Value))}"))
                .Concat([
                    string.Create(CultureInfo.InvariantCulture, $"{N(X(top[^1].Date))},{N(Y(0m))}"),
                    string.Create(CultureInfo.InvariantCulture, $"{N(X(top[0].Date))},{N(Y(0m))}"),
                ]);

            yield return (string.Join(' ', points), stacked[index].Series);
        }
    }

    private string Reading(ChartLine line, DateOnly date) =>
        line.Points.FirstOrDefault(point => point.Date == date)?.Value is { } value
            ? (Formatter ?? Format.Euros)(value)
            : Ui["Charts_NoValue"];

    /// <summary>Tramos continuos de una línea, en coordenadas del dibujo.</summary>
    /// <summary>Cuántos puntos se llegan a dibujar de una línea. Ver <see cref="ChartSampling"/>.</summary>
    private const int MaxDrawnPoints = Width;

    /// <summary>
    /// Las fechas que la serie tiene de verdad, ordenadas y sin repetir.
    /// </summary>
    /// <remarks>
    /// De aquí salen las bandas del cursor, para que posarse siempre caiga en un punto
    /// que existe y la lectura diga algo.
    /// </remarks>
    private IReadOnlyList<DateOnly> Dates =>
        [.. Lines.SelectMany(line => line.Points).Select(point => point.Date).Distinct().OrderBy(date => date)];

    /// <summary>Lo ancho que se dibuja cada vela, dejando aire entre ellas.</summary>
    private double CandleWidth => Math.Max(1.5, ((double)(Width - Left - Right) / Math.Max(1, Candles!.Count)) * 0.6);

    /// <summary>El cuerpo de una vela: de la apertura al cierre, con un mínimo visible.</summary>
    private (double Top, double Height) Body(ChartCandle candle)
    {
        var open = Y(candle.Open);
        var close = Y(candle.Close);
        var top = Math.Min(open, close);

        return (top, Math.Max(1, Math.Abs(open - close)));
    }

    /// <summary>
    /// La banda del recorrido: los máximos de ida y los mínimos de vuelta.
    /// </summary>
    private string Band()
    {
        var ordered = Candles!.OrderBy(candle => candle.Date).ToList();

        var highs = ordered.Select(candle =>
            string.Create(CultureInfo.InvariantCulture, $"{N(X(candle.Date))},{N(Y(candle.High))}"));

        var lows = ordered.AsEnumerable().Reverse().Select(candle =>
            string.Create(CultureInfo.InvariantCulture, $"{N(X(candle.Date))},{N(Y(candle.Low))}"));

        return string.Join(' ', highs.Concat(lows));
    }

    private IEnumerable<string> Segments(ChartLine line)
    {
        var segment = new List<string>();

        foreach (var point in ChartSampling.Reduce([.. line.Points.OrderBy(point => point.Date)], MaxDrawnPoints))
        {
            if (point.Value is not { } value)
            {
                if (segment.Count > 1)
                {
                    yield return string.Join(' ', segment);
                }

                segment.Clear();

                continue;
            }

            segment.Add(string.Create(CultureInfo.InvariantCulture, $"{X(point.Date)},{Y(value)}"));
        }

        if (segment.Count > 1)
        {
            yield return string.Join(' ', segment);
        }
    }

    private double X(DateOnly date)
    {
        var span = Math.Max(_bounds!.To.DayNumber - _bounds.From.DayNumber, 1);

        return Left + ((double)(date.DayNumber - _bounds.From.DayNumber) / span * (Width - Left - Right));
    }

    private double Y(decimal value)
    {
        var span = _bounds!.Highest - _bounds.Lowest;
        var share = span == 0m ? 0.5m : (value - _bounds.Lowest) / span;

        return (Height - Bottom) - ((double)share * (Height - Bottom - Top));
    }

    private void OnLeave() => _hover = null;

    /// <summary>
    /// Una etiqueta del eje.
    /// </summary>
    /// <remarks>
    /// Se compone como marcado y no como elemento porque Razor reserva la etiqueta
    /// «text» para su propia sintaxis dentro de un bloque de código.
    /// </remarks>
    private static MarkupString Label(double x, double y, string value, string anchor) =>
        new(string.Create(
            CultureInfo.InvariantCulture,
            $"""<text x="{x}" y="{y}" class="chart-label" text-anchor="{anchor}">{System.Net.WebUtility.HtmlEncode(value)}</text>"""));

    /// <summary>
    /// Un número para un atributo del dibujo.
    /// </summary>
    /// <remarks>
    /// Con la cultura del usuario los decimales salen con coma y el SVG no los entiende:
    /// el elemento se dibuja con cero de ancho y deja de responder al ratón sin que nada
    /// falle.
    /// </remarks>
    private static string N(double value) => value.ToString("0.###", CultureInfo.InvariantCulture);

    private static string Moment(DateOnly date) => date.ToString("d", CultureInfo.CurrentCulture);

    /// <summary>Los extremos de la serie y las alturas de la rejilla.</summary>
    private sealed record Bounds(DateOnly From, DateOnly To, decimal Lowest, decimal Highest)
    {
        internal IReadOnlyList<decimal> GridLines =>
            [Lowest, Lowest + ((Highest - Lowest) / 2m), Highest];

        internal static Bounds? Of(IReadOnlyList<ChartLine> lines, IReadOnlyList<ChartCandle>? candles = null)
        {
            var points = lines.SelectMany(line => line.Points).Where(point => point.Value is not null).ToList();

            if (points.Count == 0)
            {
                return null;
            }

            // Los extremos del dibujo tienen que abarcar los máximos y mínimos, o las
            // mechas de las velas se saldrían por arriba y por abajo.
            var lowest = Math.Min(
                points.Min(point => point.Value!.Value),
                candles is { Count: > 0 } ? candles.Min(candle => candle.Low) : decimal.MaxValue);

            var highest = Math.Max(
                points.Max(point => point.Value!.Value),
                candles is { Count: > 0 } ? candles.Max(candle => candle.High) : decimal.MinValue);

            // Un suelo en cero hace comparable la altura entre gráficas y evita que una
            // variación del uno por ciento parezca un desplome.
            return new Bounds(
                lines.SelectMany(line => line.Points).Min(point => point.Date),
                lines.SelectMany(line => line.Points).Max(point => point.Date),
                Math.Min(lowest, 0m),
                highest);
        }

        /// <summary>
        /// Las bandas sensibles al ratón, una por punto de la serie.
        /// </summary>
        /// <remarks>
        /// Las fechas salen de la propia serie y no del calendario. Repartiendo días
        /// entre los extremos, con la serie agrupada por semanas o meses el cursor caía
        /// en fechas que no existen como punto y la lectura salía vacía; y con una serie
        /// diaria con huecos, caía en los huecos.
        ///
        /// Se agrupan en como mucho doscientas: una por punto dejaría miles de elementos
        /// para distinguir posiciones que ni siquiera llegan a un píxel.
        /// </remarks>
        internal IEnumerable<(double X, double Width, DateOnly Date)> Bands(
            double left,
            double right,
            IReadOnlyList<DateOnly> dates)
        {
            if (dates.Count == 0)
            {
                yield break;
            }

            var count = Math.Min(dates.Count, 200);
            var width = (right - left) / count;

            for (var index = 0; index < count; index++)
            {
                var at = (int)Math.Round((double)index / Math.Max(1, count - 1) * (dates.Count - 1));

                yield return (left + (index * width), width, dates[Math.Min(at, dates.Count - 1)]);
            }
        }
    }
}
