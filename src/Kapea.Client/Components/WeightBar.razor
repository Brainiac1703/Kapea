@* Peso de una posición: la cifra y una barra corta que se compara de un vistazo con
   las de las filas de al lado. En SVG para que el ancho sea un atributo del dibujo y
   no un estilo en línea. *@
<span class="weight">
    <svg class="weight-track" viewBox="0 0 100 6" preserveAspectRatio="none" aria-hidden="true">
        <rect width="100" height="6" rx="3" class="weight-rest"></rect>
        <rect width="@Width" height="6" rx="3" class="@Series"></rect>
    </svg>
    <span class="weight-value">@Format.Percent(Weight, Missing)</span>
</span>

@code {
    /// <summary>Tanto por uno. Nulo cuando la posición no tiene precio.</summary>
    [Parameter]
    public decimal? Weight { get; set; }

    [Parameter, EditorRequired]
    public required string Missing { get; set; }

    /// <summary>Clase de la serie, para que la barra lleve el color de su clase de activo.</summary>
    [Parameter]
    public string Series { get; set; } = "series-0";

    private string Width => string.Create(
        System.Globalization.CultureInfo.InvariantCulture,
        $"{Math.Clamp(Weight ?? 0m, 0m, 1m) * 100m:0.##}");
}
