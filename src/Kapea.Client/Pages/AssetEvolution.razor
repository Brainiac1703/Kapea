@page "/evolution/{AssetId:guid}"
@inject KapeaApiClient Api
@inject IToastService Toasts

<PageTitle>@Ui["Asset_Title"]</PageTitle>

<FluentLabel Typo="Typography.PageTitle">
    @Ui["Asset_Title"] @(_history?.AssetSymbol ?? string.Empty)
</FluentLabel>

@* Una sola fila: el periodo es lo que más se toca, así que va en botones; el intervalo
   y la ventana, que se cambian de vez en cuando, en desplegables que ocupan lo suyo y
   no nueve anchos de botón. *@
<FluentToolbar Class="chart-controls">
    @foreach (var period in ChartPeriods.Scale(Today))
    {
        <FluentButton Appearance="@(period.Label == _period ? Appearance.Accent : Appearance.Neutral)"
                      Title="@Ui[$"{period.Label}_Long"]"
                      OnClick="@(() => ChangePeriodAsync(period))">
            @Ui[period.Label]
        </FluentButton>
    }

    <FluentSpacer />

    <FluentSelect TOption="string"
                  Items="@ChartPeriods.Intervals"
                  OptionValue="@(interval => interval)"
                  OptionText="@(interval => Ui[ChartPeriods.Label(interval)])"
                  Value="@Applied"
                  ValueChanged="ChangeIntervalAsync"
                  AriaLabel="@Ui["Evolution_Interval"]" />

    <FluentSelect TOption="int"
                  Items="@Windows"
                  OptionValue="@(window => window.ToString(System.Globalization.CultureInfo.InvariantCulture))"
                  OptionText="@(window => string.Format(System.Globalization.CultureInfo.CurrentCulture, Ui["Asset_WindowOption"].Value, window))"
                  Value="@_window.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                  ValueChanged="ChangeWindowAsync"
                  AriaLabel="@Ui["Asset_Window"]" />
</FluentToolbar>

@if (_history is null)
{
    <FluentProgressRing />
}
else
{
    @* Sin recorrido sólo se puede dibujar la línea, y conviene decir por qué en lugar
       de dejar que parezca que la gráfica está a medias. *@
    @if (!_history.HasRange)
    {
        <FluentMessageBar Intent="MessageIntent.Info" AllowDismiss="false">
            @Ui["Asset_NoRange"]
        </FluentMessageBar>
    }

    @* El precio con sus medias encima: la media sola no dice nada, y el precio solo no
       deja ver la tendencia. *@
    <LineChart Lines="@Price()" Candles="@Candles()" Title="@Ui["Asset_Price"]"
               Formatter="@(value => Format.Price(value))" />

    @* Las cifras debajo, para no tener que estimarlas a ojo sobre el dibujo. *@
    @if (_history.Figures is { } figures)
    {
        <div class="chart-figures">
            @Figure("Asset_Figure_Open", figures.Open)
            @Figure("Asset_Figure_High", figures.High)
            @Figure("Asset_Figure_Low", figures.Low)
            @Figure("Asset_Figure_Close", figures.Close)
            @Figure("Asset_Figure_PeriodHigh", figures.PeriodHigh)
            @Figure("Asset_Figure_PeriodLow", figures.PeriodLow)
            @Change("Asset_Figure_PeriodChange", figures.PeriodChange)
            @Figure("Asset_Figure_YearHigh", figures.YearHigh)
            @Figure("Asset_Figure_YearLow", figures.YearLow)
        </div>
    }

    <FluentLabel Typo="Typography.H4">@Ui["Asset_Strength"]</FluentLabel>

    @* La fuerza relativa va aparte porque su escala es de cero a cien: dibujarla junto
       al precio la dejaría pegada al suelo o aplastaría el precio. *@
    @* Treinta y setenta son los umbrales con los que se lee: sin ellos la línea sube y
       baja sin que nada diga cuándo es mucho. *@
    <LineChart Lines="@Strength()" Title="@Ui["Asset_Strength"]"
               Reference="@(new decimal[] { 30m, 70m })"
               Formatter="@(value => Format.Compact(value))" />

    <FluentLabel Typo="Typography.Body" Class="chart-note">@Ui["Asset_StrengthNote"]</FluentLabel>
}

@code {
    private static readonly int[] Windows = [7, 20, 50];

    /// <summary>
    /// Los periodos que se ofrecen. «Todo» no es un número de días porque cuánto hay
    /// depende del activo: uno tiene veinte años de cotizaciones y otro tres meses.
    /// </summary>
    private static DateOnly Today => DateOnly.FromDateTime(DateTime.UtcNow);

    private string _period = "Evolution_Period_Year";
    private int? _days = 365;

    /// <summary>Intervalo elegido a mano. Sin él manda el que sugiere el periodo.</summary>
    private string? _interval;

    private AssetHistoryResponse? _history;
    private int _window = 20;

    /// <summary>
    /// Qué intervalo está en uso: el elegido, o el que el servidor dice haber aplicado.
    /// </summary>
    /// <remarks>
    /// Lo dice la respuesta y no una copia de la regla aquí: duplicarla haría que un día
    /// la pantalla marcara uno y el servidor devolviera otro.
    /// </remarks>
    private string Applied => _interval ?? _history?.Interval ?? "Daily";

    [Parameter]
    public Guid AssetId { get; set; }

    protected override Task OnParametersSetAsync() => ReloadAsync();

    private async Task ChangeWindowAsync(string window)
    {
        _window = int.Parse(window, System.Globalization.CultureInfo.InvariantCulture);

        await ReloadAsync();
    }

    private async Task ChangePeriodAsync(ChartPeriod period)
    {
        _period = period.Label;
        _days = period.Days;

        // El periodo vuelve a mandar sobre el intervalo: al pasar de cinco años a una
        // semana, seguir en meses dejaría un solo punto.
        _interval = null;

        await ReloadAsync();
    }

    private async Task ChangeIntervalAsync(string interval)
    {
        _interval = interval;

        await ReloadAsync();
    }


    private async Task ReloadAsync()
    {
        try
        {
            _history = await Api.GetAssetHistoryAsync(
                AssetId, days: _days, window: _window, all: _days is null, interval: _interval);
        }
        catch (KapeaApiException exception)
        {
            _history = null;
            Toasts.ShowApiError(exception);
        }
    }

    private IReadOnlyList<ChartLine> Price() =>
    [
        new ChartLine(
            Ui["Asset_Price"],
            [.. _history!.Days.Select(day => new ChartPoint(day.Date, day.PriceInEuros))],
            ChartLine.SeriesAt(0)),
        new ChartLine(Ui["Asset_Average"], Points(_history.SimpleMovingAverage), ChartLine.SeriesAt(1), Dashed: true),
        new ChartLine(
            Ui["Asset_Exponential"], Points(_history.ExponentialMovingAverage), ChartLine.SeriesAt(2), Dashed: true),
    ];

    /// <summary>
    /// El recorrido de cada tramo, cuando el proveedor lo da.
    /// </summary>
    /// <remarks>
    /// Un tramo al que le falte algún extremo se queda fuera en lugar de completarse con
    /// el cierre: dibujaría una vela sin mechas que se leería como un día sin recorrido.
    /// </remarks>
    private IReadOnlyList<ChartCandle>? Candles() => _history!.HasRange
        ?
        [
            .. _history.Days
                .Where(day => day.OpenInEuros is not null
                    && day.HighInEuros is not null
                    && day.LowInEuros is not null
                    && day.PriceInEuros is not null)
                .Select(day => new ChartCandle(
                    day.Date,
                    day.OpenInEuros!.Value,
                    day.HighInEuros!.Value,
                    day.LowInEuros!.Value,
                    day.PriceInEuros!.Value)),
        ]
        : null;

    /// <summary>Una cifra con su nombre, o dicho que no la hay.</summary>
    private RenderFragment Figure(string label, decimal? amount) => builder =>
    {
        builder.OpenElement(0, "span");
        builder.AddAttribute(1, "class", "chart-figure");
        builder.AddContent(2, Ui[label].Value);
        builder.OpenElement(3, "strong");
        builder.AddContent(4, Format.Price(amount, Ui["Charts_NoValue"].Value));
        builder.CloseElement();
        builder.CloseElement();
    };

    private RenderFragment Change(string label, decimal? ratio) => builder =>
    {
        builder.OpenElement(0, "span");
        builder.AddAttribute(1, "class", "chart-figure");
        builder.AddContent(2, Ui[label].Value);
        builder.OpenElement(3, "strong");
        builder.AddAttribute(4, "class", ratio is null ? null : ratio >= 0m ? "gain" : "loss");
        builder.AddContent(5, Format.Percent(ratio, Ui["Charts_NoValue"].Value));
        builder.CloseElement();
        builder.CloseElement();
    };

    private IReadOnlyList<ChartLine> Strength() =>
    [
        new ChartLine(Ui["Asset_Strength"], Points(_history!.RelativeStrengthIndex), ChartLine.SeriesAt(3)),
    ];

    private static IReadOnlyList<ChartPoint> Points(IReadOnlyList<IndicatorPointResponse> points) =>
        [.. points.Select(point => new ChartPoint(point.Date, point.Value))];
}
