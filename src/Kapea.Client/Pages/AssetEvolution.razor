@page "/evolution/{AssetId:guid}"
@inject KapeaApiClient Api
@inject IToastService Toasts

<PageTitle>@Ui["Asset_Title"]</PageTitle>

<FluentLabel Typo="Typography.PageTitle">
    @Ui["Asset_Title"] @(_history?.AssetSymbol ?? string.Empty)
</FluentLabel>

<FluentToolbar>
    <FluentLabel Typo="Typography.Body">@Ui["Evolution_Period"]</FluentLabel>
    @foreach (var period in ChartPeriods.Scale(Today))
    {
        <FluentButton Appearance="@(period.Label == _period ? Appearance.Accent : Appearance.Neutral)"
                      OnClick="@(() => ChangePeriodAsync(period))">
            @Ui[period.Label]
        </FluentButton>
    }
</FluentToolbar>

@* El intervalo va aparte del periodo: uno dice cuánto se mira y el otro cada cuánto se
   agrupa lo que se mira. Sin elegir, manda el que el servidor sugiere para el periodo. *@
<FluentToolbar>
    <FluentLabel Typo="Typography.Body">@Ui["Evolution_Interval"]</FluentLabel>
    @foreach (var interval in ChartPeriods.Intervals)
    {
        <FluentButton Appearance="@(interval == Using(interval) ? Appearance.Accent : Appearance.Neutral)"
                      OnClick="@(() => ChangeIntervalAsync(interval))">
            @Ui[ChartPeriods.Label(interval)]
        </FluentButton>
    }
</FluentToolbar>

<FluentToolbar>
    <FluentLabel Typo="Typography.Body">@Ui["Asset_Window"]</FluentLabel>
    @foreach (var window in Windows)
    {
        <FluentButton Appearance="@(window == _window ? Appearance.Accent : Appearance.Neutral)"
                      OnClick="@(() => ChangeAsync(window))">
            @window
        </FluentButton>
    }
</FluentToolbar>

@if (_history is null)
{
    <FluentProgressRing />
}
else
{
    @* El precio con sus medias encima: la media sola no dice nada, y el precio solo no
       deja ver la tendencia. *@
    <LineChart Lines="@Price()" Title="@Ui["Asset_Price"]" />

    <FluentLabel Typo="Typography.H4">@Ui["Asset_Strength"]</FluentLabel>

    @* La fuerza relativa va aparte porque su escala es de cero a cien: dibujarla junto
       al precio la dejaría pegada al suelo o aplastaría el precio. *@
    <LineChart Lines="@Strength()" Title="@Ui["Asset_Strength"]" Formatter="@(value => Format.Compact(value))" />
}

@code {
    private static readonly int[] Windows = [7, 20, 50];

    /// <summary>
    /// Los periodos que se ofrecen. «Todo» no es un número de días porque cuánto hay
    /// depende del activo: uno tiene veinte años de cotizaciones y otro tres meses.
    /// </summary>
    private static DateOnly Today => DateOnly.FromDateTime(DateTime.UtcNow);

    private string _period = "Evolution_Period_Year";
    private int? _days = 365;

    /// <summary>Intervalo elegido a mano. Sin él manda el que sugiere el periodo.</summary>
    private string? _interval;

    private AssetHistoryResponse? _history;
    private int _window = 20;

    /// <summary>
    /// Qué intervalo está en uso: el elegido, o el que el servidor dice haber aplicado.
    /// </summary>
    /// <remarks>
    /// Lo dice la respuesta y no una copia de la regla aquí: duplicarla haría que un día
    /// la pantalla marcara uno y el servidor devolviera otro.
    /// </remarks>
    private string Using(string interval) => _interval ?? _history?.Interval ?? "Daily";

    [Parameter]
    public Guid AssetId { get; set; }

    protected override Task OnParametersSetAsync() => ReloadAsync();

    private async Task ChangeAsync(int window)
    {
        _window = window;

        await ReloadAsync();
    }

    private async Task ChangePeriodAsync(ChartPeriod period)
    {
        _period = period.Label;
        _days = period.Days;

        // El periodo vuelve a mandar sobre el intervalo: al pasar de cinco años a una
        // semana, seguir en meses dejaría un solo punto.
        _interval = null;

        await ReloadAsync();
    }

    private async Task ChangeIntervalAsync(string interval)
    {
        _interval = interval;

        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        try
        {
            _history = await Api.GetAssetHistoryAsync(
                AssetId, days: _days, window: _window, all: _days is null, interval: _interval);
        }
        catch (KapeaApiException exception)
        {
            _history = null;
            Toasts.ShowApiError(exception);
        }
    }

    private IReadOnlyList<ChartLine> Price() =>
    [
        new ChartLine(
            Ui["Asset_Price"],
            [.. _history!.Days.Select(day => new ChartPoint(day.Date, day.PriceInEuros))],
            ChartLine.SeriesAt(0)),
        new ChartLine(Ui["Asset_Average"], Points(_history.SimpleMovingAverage), ChartLine.SeriesAt(1), Dashed: true),
        new ChartLine(
            Ui["Asset_Exponential"], Points(_history.ExponentialMovingAverage), ChartLine.SeriesAt(2), Dashed: true),
    ];

    private IReadOnlyList<ChartLine> Strength() =>
    [
        new ChartLine(Ui["Asset_Strength"], Points(_history!.RelativeStrengthIndex), ChartLine.SeriesAt(3)),
    ];

    private static IReadOnlyList<ChartPoint> Points(IReadOnlyList<IndicatorPointResponse> points) =>
        [.. points.Select(point => new ChartPoint(point.Date, point.Value))];
}
