@page "/platforms"
@inject KapeaApiClient Api
@inject IDialogService Dialogs
@inject IToastService Toasts

<PageTitle>@Ui["Platforms_Title"]</PageTitle>

<FluentLabel Typo="Typography.PageTitle">@Ui["Platforms_Heading"]</FluentLabel>
<FluentLabel Typo="Typography.Body" Class="intro">@Ui["Platforms_Intro"]</FluentLabel>

<FluentToolbar>
    <FluentButton Appearance="Appearance.Accent"
                  IconStart="@(new Icons.Regular.Size16.Add())"
                  OnClick="OpenNewPlatformAsync">
        @Ui["Platforms_New"]
    </FluentButton>
</FluentToolbar>

@if (_platforms is null)
{
    <FluentProgressRing />
}
else if (_platforms.Count == 0)
{
    <FluentMessageBar Intent="MessageIntent.Warning">@Ui["Platforms_Empty"]</FluentMessageBar>
}
else
{
    <FluentDataGrid Items="@_platforms.AsQueryable()" TGridItem="PlatformResponse" GridTemplateColumns="2fr 1fr 1fr 1fr auto">
        <PropertyColumn Property="@(platform => platform.Name)" Title="@Ui["Common_Name"]" />
        <PropertyColumn Property="@(platform => platform.Code)" Title="@Ui["Platforms_Code"]" />
        <TemplateColumn Title="@Ui["Platforms_ImportKind"]">
            @(context.ImportKind == "File" ? Ui["Platforms_ImportKind_File"] : Ui["Platforms_ImportKind_Api"])
        </TemplateColumn>
        <TemplateColumn Title="@Ui["Common_Origin"]">
            @(context.BuiltIn ? Ui["Platforms_BuiltIn"] : Ui["Platforms_Added"])
        </TemplateColumn>
        <TemplateColumn Title="@Ui["Common_Actions"]" Align="Align.End">
            @* Las de serie no se retiran: hay movimientos del histórico a su nombre y
               adaptadores que las esperan. *@
            <FluentButton Appearance="Appearance.Stealth"
                          Disabled="@context.BuiltIn"
                          IconStart="@(new Icons.Regular.Size16.Delete())"
                          Title="@Ui["Common_Delete"]"
                          OnClick="@(() => DeleteAsync(context))" />
        </TemplateColumn>
    </FluentDataGrid>
}

@code {
    private IReadOnlyList<PlatformResponse>? _platforms;

    protected override Task OnInitializedAsync() => ReloadAsync();

    private async Task ReloadAsync()
    {
        try
        {
            _platforms = await Api.GetPlatformsAsync();
        }
        catch (KapeaApiException exception)
        {
            _platforms = null;
            Toasts.ShowApiError(exception);
        }
    }

    private async Task OpenNewPlatformAsync()
    {
        var nueva = new NewPlatformModel();

        var dialog = await Dialogs.ShowDialogAsync<NewPlatformDialog, NewPlatformModel>(
            nueva,
            new DialogParameters<NewPlatformModel>
            {
                Content = nueva,
                Title = Ui["Platforms_New"],
                PrimaryAction = Ui["Common_Add"],
                SecondaryAction = Ui["Common_Cancel"],
                PreventDismissOnOverlayClick = true,
            });

        var result = await dialog.Result;

        if (result.Cancelled || result.Data is not NewPlatformModel model || !model.IsComplete)
        {
            return;
        }

        try
        {
            var created = await Api.CreatePlatformAsync(
                new CreatePlatformRequest(model.Code, model.Name, "File"));

            await ReloadAsync();

            // Dar de alta la plataforma no basta para importar: hace falta además un
            // perfil que sepa leer sus ficheros. Decirlo aquí evita que el usuario suba
            // un extracto y se encuentre un error que no esperaba.
            Toasts.ShowSuccess(created.Name);
            Toasts.ShowWarning(Ui["Platforms_NoProfileYet"]);
        }
        catch (KapeaApiException exception)
        {
            Toasts.ShowApiError(exception);
        }
    }

    private async Task DeleteAsync(PlatformResponse platform)
    {
        var confirmation = await Dialogs.ShowConfirmationAsync(
            Ui["Platforms_DeleteConfirm_Message"],
            Ui["Common_Delete"],
            Ui["Common_Cancel"],
            $"{Ui["Platforms_DeleteConfirm_Title"]}: {platform.Name}");

        if ((await confirmation.Result).Cancelled)
        {
            return;
        }

        try
        {
            await Api.DeletePlatformAsync(platform.Code);
            await ReloadAsync();
        }
        catch (KapeaApiException exception)
        {
            Toasts.ShowApiError(exception);
        }
    }
}
