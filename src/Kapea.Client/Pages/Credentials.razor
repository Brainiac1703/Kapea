@page "/credentials"
@inject KapeaApiClient Api
@inject IDialogService Dialogs
@inject IToastService Toasts

<PageTitle>@Ui["Credentials_Title"]</PageTitle>

<FluentLabel Typo="Typography.PageTitle">@Ui["Credentials_Heading"]</FluentLabel>
<FluentLabel Typo="Typography.Body" Class="intro">@Ui["Credentials_Intro"]</FluentLabel>

<FluentToolbar>
    <FluentButton Appearance="Appearance.Accent"
                  IconStart="@(new Icons.Regular.Size16.Add())"
                  Disabled="@(_apiAccounts.Count == 0)"
                  OnClick="OpenNewCredentialAsync">
        @Ui["Credentials_New"]
    </FluentButton>

    @* La sincronización automática corre cada pocas horas. Tras dar de alta una
       credencial, esperar a que toque no tiene por qué. *@
    <FluentButton IconStart="@(new Icons.Regular.Size16.ArrowSync())"
                  Disabled="@(_syncing || _credentials is null || _credentials.Count == 0)"
                  OnClick="() => SynchroniseAsync(full: false)">
        @Ui["Credentials_SyncNow"]
    </FluentButton>

    @* Releer el histórico entero hace falta cuando cambia la forma de interpretar un
       movimiento: lo ya importado se descarta por duplicado, así que solo entra lo que
       antes no se sabía leer. *@
    <FluentButton IconStart="@(new Icons.Regular.Size16.History())"
                  Disabled="@(_syncing || _credentials is null || _credentials.Count == 0)"
                  OnClick="() => SynchroniseAsync(full: true)">
        @Ui["Credentials_SyncAll"]
    </FluentButton>
</FluentToolbar>

<FluentLabel Typo="Typography.Body">@Ui["Credentials_SyncHelp"]</FluentLabel>
<FluentLabel Typo="Typography.Body">@Ui["Credentials_SyncAllHelp"]</FluentLabel>

@if (_credentials is null)
{
    <FluentProgressRing />
}
else
{
    @if (_apiAccounts.Count == 0)
    {
        <FluentMessageBar Intent="MessageIntent.Info">@Ui["Credentials_NoApiAccounts"]</FluentMessageBar>
    }

    @if (_credentials.Count == 0)
    {
        <FluentMessageBar Intent="MessageIntent.Info">@Ui["Credentials_Empty"]</FluentMessageBar>
    }
    else
    {
        <FluentDataGrid Items="@_credentials.AsQueryable()"
                        TGridItem="BrokerCredentialResponse"
                        GridTemplateColumns="1fr 1.5fr 1fr 1fr 1.5fr auto">
            <PropertyColumn Property="@(credential => credential.Platform)" Title="@Ui["Common_Platform"]" />
            <PropertyColumn Property="@(credential => credential.Alias)" Title="@Ui["Common_Alias"]" />
            <PropertyColumn Property="@(credential => credential.Scopes)" Title="@Ui["Credentials_Scopes"]" />
            <TemplateColumn Title="@Ui["Common_Status"]">
                <FluentBadge Appearance="Appearance.Neutral" BackgroundColor="@StatusColour(context.Status)">
                    @StatusText(context.Status)
                </FluentBadge>
                @if (!string.IsNullOrWhiteSpace(context.InvalidReason))
                {
                    <FluentLabel Typo="Typography.Body">@context.InvalidReason</FluentLabel>
                }
            </TemplateColumn>
            <TemplateColumn Title="@Ui["Credentials_LastSync"]">
                @(context.LastSynchronizedAt is { } moment
                    ? moment.ToLocalTime().ToString("g")
                    : Ui["Common_Never"].Value)
            </TemplateColumn>
            <TemplateColumn Title="@Ui["Common_Actions"]" Align="Align.End">
                <FluentButton Appearance="Appearance.Stealth"
                              IconStart="@(new Icons.Regular.Size16.ArrowSync())"
                              Title="@Ui["Credentials_Rotate"]"
                              OnClick="@(() => RotateAsync(context))" />
                <FluentButton Appearance="Appearance.Stealth"
                              IconStart="@(new Icons.Regular.Size16.Prohibited())"
                              Title="@Ui["Credentials_Revoke"]"
                              Disabled="@(context.Status == "Revoked")"
                              OnClick="@(() => RevokeAsync(context))" />
            </TemplateColumn>
        </FluentDataGrid>
    }
}

@code {
    /// <summary>Plataformas que se importan por API. XTB queda fuera: su histórico es un fichero.</summary>

    private bool _syncing;
    private IReadOnlyList<BrokerCredentialResponse>? _credentials;
    private IReadOnlyList<AccountResponse> _apiAccounts = [];

    protected override Task OnInitializedAsync() => ReloadAsync();

    private async Task ReloadAsync()
    {
        try
        {
            _credentials = await Api.GetCredentialsAsync();

            // Solo tienen credencial las plataformas que se leen por API, y cuáles son
            // lo dice el catálogo.
            var platforms = await Api.GetPlatformsAsync();
            var apiPlatforms = platforms
                .Where(platform => platform.ImportKind == "Api")
                .Select(platform => platform.Code)
                .ToHashSet(StringComparer.OrdinalIgnoreCase);

            var accounts = await Api.GetAccountsAsync();
            _apiAccounts = [.. accounts.Where(account => apiPlatforms.Contains(account.Platform))];
        }
        catch (KapeaApiException exception)
        {
            _credentials = null;
            Toasts.ShowApiError(exception);
        }
    }

    private async Task SynchroniseAsync(bool full)
    {
        _syncing = true;

        try
        {
            var report = await Api.SynchroniseAsync(full);

            // Los problemas se enseñan uno a uno y sin caducar: cada uno dice qué
            // plataforma falló y por qué, que es lo que hace falta para arreglarlo.
            foreach (var problem in report.Problems)
            {
                Toasts.ShowError(problem, timeout: 0);
            }

            if (report.NewRecords == 0)
            {
                Toasts.ShowInfo(Ui["Credentials_SyncedNothing"]);
            }
            else
            {
                Toasts.ShowSuccess(string.Format(
                    System.Globalization.CultureInfo.CurrentCulture,
                    Ui["Credentials_Synced"].Value,
                    report.NewRecords,
                    report.Imported));
            }

            await ReloadAsync();
        }
        catch (KapeaApiException exception)
        {
            Toasts.ShowApiError(exception);
        }
        finally
        {
            _syncing = false;
        }
    }

    private Task OpenNewCredentialAsync() =>
        AskUntilAcceptedAsync(
            new BrokerCredentialModel { AvailableAccounts = _apiAccounts },
            Ui["Credentials_New"],
            Ui["Common_Add"],
            model => Api.RegisterCredentialAsync(new RegisterBrokerCredentialRequest(
                model.AccountId, model.Platform, model.Alias, model.ApiKey, model.ApiSecret)));

    /// <summary>
    /// Pide los datos y, si la plataforma los rechaza, vuelve a pedirlos con lo escrito
    /// y el motivo encima.
    /// </summary>
    /// <remarks>
    /// La plataforma es quien decide si una clave vale, y su rechazo dice qué corregir.
    /// Cerrar el formulario y avisar aparte obliga a teclear otra vez la clave y el
    /// secreto para arreglar una sola cosa, y el aviso se va antes de poder leerlo.
    /// </remarks>
    private async Task AskUntilAcceptedAsync(
        BrokerCredentialModel model,
        string title,
        string confirm,
        Func<BrokerCredentialModel, Task<BrokerCredentialResponse>> send)
    {
        while (true)
        {
            var dialog = await Dialogs.ShowDialogAsync<BrokerCredentialDialog, BrokerCredentialModel>(
                model,
                new DialogParameters<BrokerCredentialModel>
                {
                    Content = model,
                    Title = title,
                    PrimaryAction = confirm,
                    SecondaryAction = Ui["Common_Cancel"],
                    PreventDismissOnOverlayClick = true,
                });

            var result = await dialog.Result;

            if (result.Cancelled || result.Data is not BrokerCredentialModel filled)
            {
                return;
            }

            model = filled;

            if (!model.IsComplete)
            {
                model.Error = string.Format(
                    System.Globalization.CultureInfo.CurrentCulture,
                    Ui["Form_Missing"].Value,
                    string.Join(", ", model.Missing.Select(key => Ui[key].Value)));

                continue;
            }

            try
            {
                var credential = await send(model);

                Toasts.ShowSuccess(credential.Alias);
                await ReloadAsync();

                return;
            }
            catch (KapeaApiException exception)
            {
                model.Error = exception.Message;
            }
        }
    }

    private Task RotateAsync(BrokerCredentialResponse credential) =>
        AskUntilAcceptedAsync(
            new BrokerCredentialModel { IsRotation = true, Alias = credential.Alias },
            $"{Ui["Credentials_Rotate_Title"]}: {credential.Alias}",
            Ui["Credentials_Rotate"],
            rotated => Api.RotateCredentialAsync(
                credential.Id, new RotateBrokerCredentialRequest(rotated.ApiKey, rotated.ApiSecret)));

    private async Task RevokeAsync(BrokerCredentialResponse credential)
    {
        var confirmation = await Dialogs.ShowConfirmationAsync(
            Ui["Credentials_Revoke_Message"],
            Ui["Credentials_Revoke"],
            Ui["Common_Cancel"],
            $"{Ui["Credentials_Revoke_Title"]}: {credential.Alias}");

        if ((await confirmation.Result).Cancelled)
        {
            return;
        }

        await SendAsync(() => Api.RevokeCredentialAsync(credential.Id));
    }

    /// <summary>
    /// La API verifica la credencial contra la plataforma antes de aceptarla, así que
    /// su mensaje de rechazo es el motivo real y se enseña tal cual.
    /// </summary>
    private async Task SendAsync(Func<Task<BrokerCredentialResponse>> send)
    {
        try
        {
            var credential = await send();
            Toasts.ShowSuccess(credential.Alias);
        }
        catch (KapeaApiException exception)
        {
            Toasts.ShowApiError(exception);
        }

        await ReloadAsync();
    }

    private string StatusText(string status) => status switch
    {
        "Active" => Ui["Status_Active"],
        "Revoked" => Ui["Status_Revoked"],
        _ => Ui["Status_Invalid"],
    };

    private static string StatusColour(string status) => status switch
    {
        "Active" => "var(--success)",
        "Revoked" => "var(--neutral-fill-secondary-rest)",
        _ => "var(--error)",
    };
}
