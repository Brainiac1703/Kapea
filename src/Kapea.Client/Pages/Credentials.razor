@page "/credentials"
@inject KapeaApiClient Api
@inject IDialogService Dialogs
@inject IToastService Toasts

<PageTitle>@Ui["Credentials_Title"]</PageTitle>

<FluentLabel Typo="Typography.PageTitle">@Ui["Credentials_Heading"]</FluentLabel>
<FluentLabel Typo="Typography.Body" Class="intro">@Ui["Credentials_Intro"]</FluentLabel>

<FluentToolbar>
    <FluentButton Appearance="Appearance.Accent"
                  IconStart="@(new Icons.Regular.Size16.Add())"
                  Disabled="@(_apiAccounts.Count == 0)"
                  OnClick="OpenNewCredentialAsync">
        @Ui["Credentials_New"]
    </FluentButton>
</FluentToolbar>

@if (_credentials is null)
{
    <FluentProgressRing />
}
else
{
    @if (_apiAccounts.Count == 0)
    {
        <FluentMessageBar Intent="MessageIntent.Info">@Ui["Credentials_NoApiAccounts"]</FluentMessageBar>
    }

    @if (_credentials.Count == 0)
    {
        <FluentMessageBar Intent="MessageIntent.Info">@Ui["Credentials_Empty"]</FluentMessageBar>
    }
    else
    {
        <FluentDataGrid Items="@_credentials.AsQueryable()"
                        TGridItem="BrokerCredentialResponse"
                        GridTemplateColumns="1fr 1.5fr 1fr 1fr 1.5fr auto">
            <PropertyColumn Property="@(credential => credential.Platform)" Title="@Ui["Common_Platform"]" />
            <PropertyColumn Property="@(credential => credential.Alias)" Title="@Ui["Common_Alias"]" />
            <PropertyColumn Property="@(credential => credential.Scopes)" Title="@Ui["Credentials_Scopes"]" />
            <TemplateColumn Title="@Ui["Common_Status"]">
                <FluentBadge Appearance="Appearance.Neutral" BackgroundColor="@StatusColour(context.Status)">
                    @StatusText(context.Status)
                </FluentBadge>
                @if (!string.IsNullOrWhiteSpace(context.InvalidReason))
                {
                    <FluentLabel Typo="Typography.Body">@context.InvalidReason</FluentLabel>
                }
            </TemplateColumn>
            <TemplateColumn Title="@Ui["Credentials_LastSync"]">
                @(context.LastSynchronizedAt is { } moment
                    ? moment.ToLocalTime().ToString("g")
                    : Ui["Common_Never"].Value)
            </TemplateColumn>
            <TemplateColumn Title="@Ui["Common_Actions"]" Align="Align.End">
                <FluentButton Appearance="Appearance.Stealth"
                              IconStart="@(new Icons.Regular.Size16.ArrowSync())"
                              Title="@Ui["Credentials_Rotate"]"
                              OnClick="@(() => RotateAsync(context))" />
                <FluentButton Appearance="Appearance.Stealth"
                              IconStart="@(new Icons.Regular.Size16.Prohibited())"
                              Title="@Ui["Credentials_Revoke"]"
                              Disabled="@(context.Status == "Revoked")"
                              OnClick="@(() => RevokeAsync(context))" />
            </TemplateColumn>
        </FluentDataGrid>
    }
}

@code {
    /// <summary>Plataformas que se importan por API. XTB queda fuera: su histórico es un fichero.</summary>
    private static readonly string[] ApiPlatforms = ["Kraken", "Bit2Me"];

    private IReadOnlyList<BrokerCredentialResponse>? _credentials;
    private IReadOnlyList<AccountResponse> _apiAccounts = [];

    protected override Task OnInitializedAsync() => ReloadAsync();

    private async Task ReloadAsync()
    {
        try
        {
            _credentials = await Api.GetCredentialsAsync();

            var accounts = await Api.GetAccountsAsync();
            _apiAccounts = [.. accounts.Where(account => ApiPlatforms.Contains(account.Platform))];
        }
        catch (KapeaApiException exception)
        {
            _credentials = null;
            Toasts.ShowError(exception.Message);
        }
    }

    private async Task OpenNewCredentialAsync()
    {
        var model = new BrokerCredentialModel();

        var dialog = await Dialogs.ShowDialogAsync<BrokerCredentialDialog>(
            model,
            new DialogParameters<BrokerCredentialModel>
            {
                Title = Ui["Credentials_New"],
                PreventDismissOnOverlayClick = true,
                Content = model,
            });

        var result = await dialog.Result;

        if (result.Cancelled || result.Data is not BrokerCredentialModel filled || !filled.IsComplete)
        {
            return;
        }

        await SendAsync(() => Api.RegisterCredentialAsync(new RegisterBrokerCredentialRequest(
            filled.AccountId, filled.Platform, filled.Alias, filled.ApiKey, filled.ApiSecret)));
    }

    private async Task RotateAsync(BrokerCredentialResponse credential)
    {
        var model = new BrokerCredentialModel { IsRotation = true, Alias = credential.Alias };

        var dialog = await Dialogs.ShowDialogAsync<BrokerCredentialDialog>(
            model,
            new DialogParameters { Title = $"{Ui["Credentials_Rotate_Title"]}: {credential.Alias}" });

        var result = await dialog.Result;

        if (result.Cancelled || result.Data is not BrokerCredentialModel filled || !filled.IsComplete)
        {
            return;
        }

        await SendAsync(() => Api.RotateCredentialAsync(
            credential.Id, new RotateBrokerCredentialRequest(filled.ApiKey, filled.ApiSecret)));
    }

    private async Task RevokeAsync(BrokerCredentialResponse credential)
    {
        var confirmation = await Dialogs.ShowConfirmationAsync(
            Ui["Credentials_Revoke_Message"],
            Ui["Credentials_Revoke"],
            Ui["Common_Cancel"],
            $"{Ui["Credentials_Revoke_Title"]}: {credential.Alias}");

        if ((await confirmation.Result).Cancelled)
        {
            return;
        }

        await SendAsync(() => Api.RevokeCredentialAsync(credential.Id));
    }

    /// <summary>
    /// La API verifica la credencial contra la plataforma antes de aceptarla, así que
    /// su mensaje de rechazo es el motivo real y se enseña tal cual.
    /// </summary>
    private async Task SendAsync(Func<Task<BrokerCredentialResponse>> send)
    {
        try
        {
            var credential = await send();
            Toasts.ShowSuccess(credential.Alias);
        }
        catch (KapeaApiException exception)
        {
            Toasts.ShowError(exception.Message);
        }

        await ReloadAsync();
    }

    private string StatusText(string status) => status switch
    {
        "Active" => Ui["Status_Active"],
        "Revoked" => Ui["Status_Revoked"],
        _ => Ui["Status_Invalid"],
    };

    private static string StatusColour(string status) => status switch
    {
        "Active" => "var(--success)",
        "Revoked" => "var(--neutral-fill-secondary-rest)",
        _ => "var(--error)",
    };
}
