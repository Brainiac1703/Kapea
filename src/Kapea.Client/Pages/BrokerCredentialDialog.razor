@implements IDialogContentComponent<BrokerCredentialModel>

<FluentStack Orientation="Orientation.Vertical" VerticalGap="16">
    <FluentMessageBar Intent="MessageIntent.Warning" AllowDismiss="false">
        @Ui["Credentials_Warning"]
    </FluentMessageBar>

    @if (!Content.IsRotation)
    {
        @* El valor se enlaza además de escuchar el cambio: escuchando solo, una cuenta
           que ya se ve elegida al abrir nunca se asigna, porque el usuario no llega a
           cambiar nada. El formulario se enviaría sin cuenta. *@
        <FluentSelect TOption="AccountResponse"
                      Label="@Ui["Credentials_Account"]"
                      Items="@Content.AvailableAccounts"
                      OptionValue="@(account => account.Id.ToString())"
                      OptionText="@(account => $"{account.Alias} ({account.Platform})")"
                      Value="@Content.AccountId.ToString()"
                      SelectedOptionChanged="OnAccountSelected"
                      Required="true" />

        <FluentTextField @bind-Value="Content.Alias"
                         Label="@Ui["Common_Alias"]"
                         Required="true"
                         Style="width: 100%" />
    }

    <FluentTextField @bind-Value="Content.ApiKey"
                     Label="@Ui["Credentials_ApiKey"]"
                     Required="true"
                     Style="width: 100%" />

    @* El secreto se escribe enmascarado y no se guarda en ningún estado del cliente
       más allá de este diálogo: viaja al servidor y desaparece con el componente. *@
    <FluentTextField @bind-Value="Content.ApiSecret"
                     Label="@Ui["Credentials_ApiSecret"]"
                     TextFieldType="TextFieldType.Password"
                     Required="true"
                     Style="width: 100%" />
</FluentStack>

@code {
    [Parameter]
    public BrokerCredentialModel Content { get; set; } = new();

    /// <summary>
    /// Deja elegida la primera cuenta al abrir.
    /// </summary>
    /// <remarks>
    /// Es la que el desplegable ya enseña, así que dejarla sin asignar haría que lo
    /// mostrado y lo enviado no coincidieran.
    /// </remarks>
    protected override void OnInitialized()
    {
        if (!Content.IsRotation
            && Content.AccountId == Guid.Empty
            && Content.AvailableAccounts.FirstOrDefault() is { } first)
        {
            OnAccountSelected(first);
        }
    }

    private void OnAccountSelected(AccountResponse? account)
    {
        if (account is null)
        {
            return;
        }

        Content.AccountId = account.Id;
        Content.Platform = account.Platform;
        Content.Alias = string.IsNullOrWhiteSpace(Content.Alias) ? account.Alias : Content.Alias;
    }
}
