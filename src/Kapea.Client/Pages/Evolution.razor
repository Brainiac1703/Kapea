@page "/evolution"
@inject KapeaApiClient Api
@inject IToastService Toasts

<PageTitle>@Ui["Evolution_Title"]</PageTitle>

<FluentLabel Typo="Typography.PageTitle">@Ui["Evolution_Heading"]</FluentLabel>
<FluentLabel Typo="Typography.Body" Class="intro">@Ui["Evolution_Intro"]</FluentLabel>

<FluentToolbar>
    <FluentLabel Typo="Typography.Body">@Ui["Evolution_Period"]</FluentLabel>
    @foreach (var period in Periods)
    {
        <FluentButton Appearance="@(period.Days == _days ? Appearance.Accent : Appearance.Neutral)"
                      OnClick="@(() => ChangeAsync(period.Days))">
            @Ui[period.Label]
        </FluentButton>
    }
</FluentToolbar>

@if (_history is null)
{
    <FluentProgressRing />
}
else
{
    @* El rendimiento va antes de la gráfica: es la respuesta a si lo estás haciendo
       bien, y la gráfica es el detalle de cómo se llegó ahí. *@
    @if (_performance is { } performance)
    {
        @if (!performance.IsComplete)
        {
            <FluentMessageBar Intent="MessageIntent.Warning" AllowDismiss="false">
                @Ui["Performance_Incomplete"]
            </FluentMessageBar>
        }

        <FluentLabel Typo="Typography.H4">@Ui["Performance_Heading"]</FluentLabel>
        <FluentLabel Typo="Typography.Body" Class="intro">@Ui["Performance_Intro"]</FluentLabel>

        <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="32" Class="counts">
            <div class="count">
                <div class="count-value @Format.Sign(performance.TimeWeightedReturn)">
                    @Format.Rate(performance.TimeWeightedReturn, Ui["Charts_NoValue"])
                </div>
                <div class="count-label">@Ui["Performance_TimeWeighted"]</div>
            </div>
            <div class="count">
                <div class="count-value @Format.Sign(performance.MoneyWeightedReturn)">
                    @Format.Rate(performance.MoneyWeightedReturn, Ui["Charts_NoValue"])
                </div>
                <div class="count-label">@Ui["Performance_MoneyWeighted"]</div>
            </div>
            <div class="count">
                <div class="count-value">@Format.Rate(performance.Volatility, Ui["Charts_NoValue"])</div>
                <div class="count-label">@Ui["Performance_Volatility"]</div>
            </div>
            <div class="count">
                <div class="count-value loss">@Format.Rate(-performance.MaximumDrawdown, Ui["Charts_NoValue"])</div>
                <div class="count-label">@Ui["Performance_Drawdown"]</div>
            </div>
        </FluentStack>

        <FluentLabel Typo="Typography.Body" Class="intro">
            @(performance.DrawdownRecoveredInDays is { } recovered
                ? string.Format(System.Globalization.CultureInfo.CurrentCulture,
                    Ui["Performance_Recovered"].Value, recovered)
                : Ui["Performance_NotRecovered"].Value)
        </FluentLabel>

        @if (performance.BenchmarkSymbol is { Length: > 0 } reference)
        {
            <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="32" Class="counts">
                <div class="count">
                    <div class="count-value @Format.Sign(performance.BenchmarkReturn)">
                        @Format.Rate(performance.BenchmarkReturn, Ui["Charts_NoValue"])
                    </div>
                    <div class="count-label">@Ui["Performance_BenchmarkReturn"] · @reference</div>
                </div>
                <Amount Label="@Ui["Performance_Benchmark"]" Value="@performance.BenchmarkValueInEuros" />
            </FluentStack>

            <FluentLabel Typo="Typography.Body" Class="intro">
                @string.Format(System.Globalization.CultureInfo.CurrentCulture,
                    Ui["Performance_BenchmarkHelp"].Value, reference)
            </FluentLabel>

            <FluentMessageBar Intent="MessageIntent.Info" AllowDismiss="false">
                @(performance.TimeWeightedReturn >= (performance.BenchmarkReturn ?? decimal.MinValue)
                    ? Ui["Performance_Beating"]
                    : Ui["Performance_Losing"])
            </FluentMessageBar>
        }
        else
        {
            <FluentMessageBar Intent="MessageIntent.Info" AllowDismiss="false">
                @Ui["Performance_NoBenchmark"]
            </FluentMessageBar>
        }
    }

    @* El aviso va antes de la gráfica: una línea que cae porque falta un precio se lee
       igual que una pérdida si nadie dice lo contrario. *@
    @if (_history.IncompleteDays > 0)
    {
        <FluentMessageBar Intent="MessageIntent.Warning" AllowDismiss="false">
            @string.Format(System.Globalization.CultureInfo.CurrentCulture,
                Ui["Evolution_Incomplete"].Value, _history.IncompleteDays)
        </FluentMessageBar>
    }

    <LineChart Lines="@Wealth()" Title="@Ui["Evolution_Heading"]" />

    <FluentLabel Typo="Typography.H4">@Ui["Evolution_ByClass"]</FluentLabel>

    <LineChart Lines="@ByClass()" Title="@Ui["Evolution_ByClass"]" Stacked="true" />
}

@code {
    private static readonly (string Label, int? Days)[] Periods =
    [
        ("Evolution_Period_Month", 30),
        ("Evolution_Period_Quarter", 90),
        ("Evolution_Period_Year", 365),
        ("Evolution_Period_All", 3650),
    ];

    private PortfolioHistoryResponse? _history;
    private PerformanceResponse? _performance;
    private int? _days = 365;

    protected override Task OnInitializedAsync() => ReloadAsync();

    private async Task ChangeAsync(int? days)
    {
        _days = days;

        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        try
        {
            _history = await Api.GetHistoryAsync(_days);
            _performance = await Api.GetPerformanceAsync(_days);
        }
        catch (KapeaApiException exception)
        {
            _history = null;
            _performance = null;
            Toasts.ShowApiError(exception);
        }
    }

    /// <summary>
    /// El patrimonio y lo aportado, juntos.
    /// </summary>
    /// <remarks>
    /// Se dibujan en la misma gráfica a propósito: la distancia entre las dos líneas es
    /// lo que se ha ganado o perdido, y separadas hay que compararlas de memoria.
    /// </remarks>
    private IReadOnlyList<ChartLine> Wealth()
    {
        var running = 0m;
        var contributed = new List<ChartPoint>();

        foreach (var day in _history!.Days)
        {
            running += day.ContributionInEuros;
            contributed.Add(new ChartPoint(day.Date, running));
        }

        return
        [
            new ChartLine(
                Ui["Evolution_Wealth"],
                [.. _history.Days.Select(day => new ChartPoint(day.Date, day.IsComplete ? day.ValueInEuros : null))],
                ChartLine.ColorAt(0)),
            new ChartLine(Ui["Evolution_Contributed"], contributed, ChartLine.ColorAt(1), Dashed: true),
        ];
    }

    /// <summary>Una línea por clase de activo, con las que haya en el periodo.</summary>
    private IReadOnlyList<ChartLine> ByClass()
    {
        var classes = _history!.ByClass
            .SelectMany(day => day.ValueByClass.Keys)
            .Distinct()
            .OrderBy(name => name, StringComparer.Ordinal)
            .ToList();

        return
        [
            .. classes.Select((name, index) => new ChartLine(
                ClassName(name),
                [
                    .. _history.ByClass.Select(day => new ChartPoint(
                        day.Date,
                        day.ValueByClass.TryGetValue(name, out var value) ? value : null)),
                ],
                ChartLine.ColorAt(index))),
        ];
    }

    private string ClassName(string assetClass) => assetClass switch
    {
        "Equity" => Ui["Portfolio_ClassEquity"],
        "Crypto" => Ui["Portfolio_ClassCrypto"],
        _ => assetClass,
    };
}
