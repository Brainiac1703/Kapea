@page "/portfolio"
@inject KapeaApiClient Api
@inject IToastService Toasts

<PageTitle>@Ui["Portfolio_Title"]</PageTitle>

<FluentLabel Typo="Typography.PageTitle">@Ui["Portfolio_Heading"]</FluentLabel>
<FluentLabel Typo="Typography.Body" Class="intro">@Ui["Portfolio_Intro"]</FluentLabel>

<FluentToolbar>
    <FluentButton IconStart="@(new Icons.Regular.Size16.ArrowSync())" OnClick="RecalculateAsync">
        @Ui["Portfolio_Recalculate"]
    </FluentButton>
    <FluentButton IconStart="@(new Icons.Regular.Size16.ArrowClockwise())" OnClick="ReloadAsync">
        @Ui["Portfolio_Refresh"]
    </FluentButton>
</FluentToolbar>

@if (_portfolio is null)
{
    <FluentProgressRing />
}
else
{
    @* Las advertencias van arriba y no al pie: quien mira estas cifras tiene que saber
       que están incompletas antes de leerlas, no después. *@
    @if (_portfolio.UnclassifiedTransactionCount > 0 || _portfolio.PendingTransferCount > 0)
    {
        <FluentMessageBar Intent="MessageIntent.Warning" AllowDismiss="false">
            @Ui["Portfolio_Incomplete"]
            <FluentAnchor Href="review" Appearance="Appearance.Hypertext">@Ui["Nav_Review"]</FluentAnchor>
        </FluentMessageBar>
    }

    @if (_portfolio.Inconsistencies.Count > 0)
    {
        <FluentMessageBar Intent="MessageIntent.Error" AllowDismiss="false">
            <div>@Ui["Portfolio_Inconsistencies"]</div>
            <ul class="inconsistencies">
                @foreach (var inconsistency in _portfolio.Inconsistencies)
                {
                    <li>@Text(inconsistency)</li>
                }
            </ul>
        </FluentMessageBar>
    }

    @if (_portfolio.MissingPrices)
    {
        <FluentMessageBar Intent="MessageIntent.Warning" AllowDismiss="false">
            @Ui["Portfolio_MissingPrices"]
        </FluentMessageBar>
    }

    @if (_portfolio.MissingCash)
    {
        <FluentMessageBar Intent="MessageIntent.Warning" AllowDismiss="false">
            @Ui["Portfolio_MissingCash"]
        </FluentMessageBar>
    }

    @* La concentración no es un error, pero no se ve mirando una tabla de doce filas. *@
    @if (_portfolio.Concentration is { } concentration)
    {
        <FluentMessageBar Intent="MessageIntent.Info" AllowDismiss="false">
            @Concentration(concentration)
        </FluentMessageBar>
    }

    <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="32" Class="counts">
        <Amount Label="@Ui["Portfolio_Wealth"]" Value="@_portfolio.WealthInEuros" />
        @* Lo puesto de tu bolsillo, al lado de lo que hay: es la comparación que
           contesta a si se gana o se pierde dinero, y no estaba en ninguna pantalla. *@
        @if (_portfolio.Contributed is { } contributed)
        {
            <Amount Label="@Ui["Portfolio_Contributed"]" Value="@contributed.NetInEuros" />
        }
        <Amount Label="@Ui["Portfolio_TotalValue"]" Value="@_portfolio.TotalMarketValueInEuros" />
        <Amount Label="@Ui["Portfolio_TotalCost"]" Value="@_portfolio.TotalCostInEuros" />
        <Amount Label="@Ui["Portfolio_Realized"]" Value="@_portfolio.RealizedResultInEuros" />
        <Amount Label="@Ui["Portfolio_Unrealised"]" Value="@_portfolio.UnrealisedResultInEuros" />
        <Amount Label="@Ui["Portfolio_Accumulated"]"
                Value="@(_portfolio.RealizedResultInEuros + _portfolio.UnrealisedResultInEuros)" />
    </FluentStack>

    @if (_portfolio.Contributed is { } capital)
    {
        <FluentLabel Typo="Typography.Body" Class="intro">
            @ContributedNote(capital)
        </FluentLabel>

        @if (capital.MissesAssetsFromOutside)
        {
            <FluentMessageBar Intent="MessageIntent.Warning" AllowDismiss="false">
                @Ui["Portfolio_ContributedShort"]
            </FluentMessageBar>
        }
    }

    @if (_loadedAt is { } loaded)
    {
        <FluentLabel Typo="Typography.Body" Class="intro">
            @Ui["Portfolio_UpdatedAt"] @Format.Moment(loaded)
        </FluentLabel>
    }

    @if (_portfolio.Groups.Count == 0)
    {
        <FluentMessageBar Intent="MessageIntent.Info">@Ui["Portfolio_Empty"]</FluentMessageBar>
    }

    @* Un grupo por clase de activo, con sus subtotales. Salen de los datos, así que una
       clase nueva aparece sola sin tocar la pantalla. *@
    @foreach (var group in OrderedGroups)
    {
        <FluentLabel Typo="Typography.H4">@ClassName(group.AssetClass)</FluentLabel>

        <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="32" Class="counts">
            <Amount Label="@Ui["Portfolio_MarketValue"]" Value="@group.MarketValueInEuros" />
            <Amount Label="@Ui["Portfolio_Cost"]" Value="@group.CostInEuros" />
            <div class="count">
                <div class="count-value">@Format.Percent(group.Weight, Ui["Portfolio_NoPrice"])</div>
                <div class="count-label">@Ui["Portfolio_Weight"]</div>
            </div>
        </FluentStack>

        <FluentDataGrid Items="@group.Positions.AsQueryable()"
                        TGridItem="OpenPositionResponse"
                        GridTemplateColumns="0.9fr 1fr 1fr 1.1fr 0.9fr 1.7fr 0.9fr 0.8fr 1.3fr">
            <TemplateColumn Title="@Ui["Common_Asset"]">
                @* El símbolo lleva a su evolución: es donde se mira cuando una posición
                   llama la atención en la tabla. *@
                <FluentAnchor Href="@($"evolution/{context.AssetId}")"
                              Appearance="Appearance.Hypertext"
                              Title="@Ui["Asset_Chart"]">
                    @context.AssetSymbol
                </FluentAnchor>
                @if (!context.AssetIsVerified)
                {
                    <FluentIcon Value="@(new Icons.Regular.Size16.Warning())"
                                Title="@Ui["Portfolio_Unverified"]" />
                }
            </TemplateColumn>
            <TemplateColumn Title="@Ui["Common_Quantity"]" Align="Align.End">@Format.Quantity(context.Quantity)</TemplateColumn>
            <TemplateColumn Title="@Ui["Portfolio_AverageCost"]" Align="Align.End">@Euros(context.AverageCostInEuros)</TemplateColumn>

            @* El instante acompaña al precio: un precio sin fecha no se puede contrastar
               con nada, y uno de hace tres días se lee como el de ahora. *@
            <TemplateColumn Title="@Ui["Portfolio_MarketPrice"]" Align="Align.End">
                @Euros(context.MarketPriceInEuros)
                @if (context.PriceAsOf is { } asOf)
                {
                    <div class="moment">@Ui["Portfolio_PriceAsOf"] @Format.Moment(asOf)</div>
                }
            </TemplateColumn>
            <TemplateColumn Title="@Ui["Portfolio_MarketValue"]" Align="Align.End">@Euros(context.MarketValueInEuros)</TemplateColumn>
            @* Resultado con signo, flecha y porcentaje sobre el coste: el color acompaña, y
               sin el porcentaje cien euros de una posición pequeña y de una grande se
               leerían igual. *@
            <TemplateColumn Title="@Ui["Portfolio_Unrealised"]" Align="Align.End">
                @if (context.UnrealisedResultInEuros is { } unrealised)
                {
                    <Delta Amount="@unrealised" Rate="@RateOnCost(unrealised, context.CostInEuros)" Plain="true" />
                }
                else
                {
                    @Ui["Portfolio_NoPrice"]
                }
            </TemplateColumn>
            <TemplateColumn Title="@Ui["Portfolio_Realized"]" Align="Align.End">
                <Delta Amount="@context.RealizedResultInEuros" Plain="true" />
            </TemplateColumn>
            <TemplateColumn Title="@Ui["Portfolio_Fees"]" Align="Align.End">@Format.Euros(context.FeesInEuros)</TemplateColumn>
            <TemplateColumn Title="@Ui["Portfolio_Weight"]">
                <WeightBar Weight="@context.Weight" Missing="@Ui["Portfolio_NoPrice"]" Series="@GroupSeries(group)" />

                @* Los niveles del sistema que propuso entrar, con el aviso cuando el
                   precio ya los ha alcanzado. Es un aviso: Kapea no ejecuta nada. *@
                @if (context.TargetInEuros is not null || context.StopLossInEuros is not null)
                {
                    <div class="moment">
                        @Ui["Strategies_Target"]: @Euros(context.TargetInEuros)
                        @if (context.ReachedTarget)
                        {
                            <FluentIcon Value="@(new Icons.Regular.Size16.CheckmarkCircle())"
                                        Color="Color.Success"
                                        Title="@Ui["Ideas_Reached"]" />
                        }
                    </div>
                    <div class="moment">
                        @Ui["Strategies_Stop"]: @Euros(context.StopLossInEuros)
                        @if (context.ReachedStopLoss)
                        {
                            <FluentIcon Value="@(new Icons.Regular.Size16.Warning())"
                                        Color="Color.Warning"
                                        Title="@Ui["Ideas_Stopped"]" />
                        }
                    </div>
                }
            </TemplateColumn>
        </FluentDataGrid>
    }

    <FluentLabel Typo="Typography.H4">@Ui["Portfolio_Cash"]</FluentLabel>
    <FluentLabel Typo="Typography.Body" Class="intro">@Ui["Portfolio_CashNote"]</FluentLabel>

    @if (_portfolio.Cash.Count == 0)
    {
        <FluentMessageBar Intent="MessageIntent.Info">@Ui["Portfolio_CashEmpty"]</FluentMessageBar>
    }
    else
    {
        <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="32" Class="counts">
            <Amount Label="@Ui["Common_Total"]" Value="@_portfolio.CashTotalInEuros" />
        </FluentStack>

        <FluentDataGrid Items="@_portfolio.Cash.AsQueryable()"
                        TGridItem="CashBalanceResponse"
                        GridTemplateColumns="2fr 1fr 1fr">
            <TemplateColumn Title="@Ui["Portfolio_Account"]">@context.AccountAlias</TemplateColumn>
            <TemplateColumn Title="@Ui["Portfolio_Currency"]">@context.Currency</TemplateColumn>
            <TemplateColumn Title="@Ui["Common_Amount"]">
                @Format.Money(context.Amount, context.Currency)
            </TemplateColumn>
        </FluentDataGrid>
    }

    @if (_portfolio.Income.Count > 0)
    {
        <FluentLabel Typo="Typography.H4">@Ui["Portfolio_Income"]</FluentLabel>

        <FluentDataGrid Items="@_portfolio.Income.AsQueryable()"
                        TGridItem="IncomeByClassResponse"
                        GridTemplateColumns="2fr 1fr 1fr 1fr">
            <TemplateColumn Title="@Ui["Common_Asset"]">@ClassName(context.AssetClass)</TemplateColumn>
            <TemplateColumn Title="@Ui["Portfolio_Gross"]">@Format.Euros(context.GrossInEuros)</TemplateColumn>
            <TemplateColumn Title="@Ui["Portfolio_Withholding"]">@Format.Euros(context.WithholdingInEuros)</TemplateColumn>
            <TemplateColumn Title="@Ui["Portfolio_Net"]">@Format.Euros(context.NetInEuros)</TemplateColumn>
        </FluentDataGrid>
    }
}

@code {
    private PortfolioResponse? _portfolio;
    private DateTimeOffset? _loadedAt;

    protected override Task OnInitializedAsync() => ReloadAsync();

    private async Task ReloadAsync()
    {
        try
        {
            _portfolio = await Api.GetPortfolioAsync();
            _loadedAt = DateTimeOffset.Now;
        }
        catch (KapeaApiException exception)
        {
            _portfolio = null;
            Toasts.ShowApiError(exception);
        }
    }

    private async Task RecalculateAsync()
    {
        try
        {
            await Api.RecalculatePortfolioAsync();
        }
        catch (KapeaApiException exception)
        {
            Toasts.ShowApiError(exception);
        }

        await ReloadAsync();
    }

    /// <summary>
    /// Nombre de la clase de activo.
    /// </summary>
    /// <remarks>
    /// Una clase que el servidor conozca y la pantalla no se enseña con su código en
    /// lugar de desaparecer: es feo, pero el dinero sigue estando a la vista.
    /// </remarks>
    /// <summary>
    /// Lo puesto, lo sacado y cómo ha ido, en una frase.
    /// </summary>
    /// <remarks>
    /// Va en texto seguido y no en más cifras sueltas: junto al patrimonio ya hay seis,
    /// y la séptima dejaría de leerse. Lo que importa es la comparación, no el desglose.
    /// </remarks>
    private string ContributedNote(ContributedCapitalResponse capital)
    {
        if (capital.Share is not { } share)
        {
            return Ui["Portfolio_ContributedNone"];
        }

        return string.Format(
            System.Globalization.CultureInfo.CurrentCulture,
            Ui["Portfolio_ContributedNote"].Value,
            Format.Euros(capital.DepositedInEuros),
            Format.Euros(capital.WithdrawnInEuros),
            Format.SignedEuros(capital.ResultInEuros),
            Format.Percent(share, string.Empty));
    }

    /// <summary>
    /// Lo que le falta al cálculo, dicho en el idioma de quien lo lee.
    /// </summary>
    /// <remarks>
    /// El texto se compone aquí y no en el servidor: el motor manda el dato —qué clase
    /// de incoherencia, qué activo, qué día y cuánto falta— y la frase sale de los
    /// recursos, como cualquier otra que ve el usuario.
    /// </remarks>
    private string Text(InconsistencyResponse inconsistency)
    {
        var asset = inconsistency.AssetSymbol;
        var day = Format.Moment(inconsistency.OccurredAt);
        var missing = Format.Quantity(inconsistency.MissingQuantity);

        return inconsistency.Kind switch
        {
            "InsufficientLots" => Ui["Inconsistency_InsufficientLots", asset, day, missing],
            "InsufficientLotsForTransfer" => Ui["Inconsistency_InsufficientLotsForTransfer", asset, day, missing],
            "SplitWithoutRatio" => Ui["Inconsistency_SplitWithoutRatio", asset, day],
            _ => Ui["Inconsistency_Unknown", asset, day],
        };
    }

    private string ClassName(string assetClass) => assetClass switch
    {
        "Equity" => Ui["Portfolio_ClassEquity"],
        "Crypto" => Ui["Portfolio_ClassCrypto"],
        _ => assetClass,
    };

    /// <summary>Cuánto concentran las mayores posiciones, dicho en una línea.</summary>
    private string Concentration(ConcentrationResponse concentration) => string.Format(
        System.Globalization.CultureInfo.CurrentCulture,
        Ui["Risk_Concentration"].Value,
        concentration.Top.Count,
        Format.Percent(concentration.Share, "?"));

    /// <summary>Un valor ausente se dice, no se disimula con un cero.</summary>
    private string Euros(decimal? amount) => Format.Euros(amount, Ui["Portfolio_NoPrice"]);

    private static string Sign(decimal? amount) => Format.Sign(amount);

    /// <summary>
    /// Grupos en orden fijo por clase.
    /// </summary>
    /// <remarks>
    /// El mismo orden que el reparto del inicio, para que cada clase lleve allí y aquí
    /// el mismo color.
    /// </remarks>
    private IReadOnlyList<PortfolioGroupResponse> OrderedGroups =>
        [.. _portfolio!.Groups.OrderBy(group => group.AssetClass, StringComparer.Ordinal)];

    private string GroupSeries(PortfolioGroupResponse group) =>
        ChartLine.SeriesAt(OrderedGroups.ToList().FindIndex(candidate => candidate.AssetClass == group.AssetClass));

    /// <summary>Resultado sobre lo que costó. Sin coste no hay porcentaje que dar.</summary>
    private static decimal? RateOnCost(decimal result, decimal cost) => cost > 0m ? result / cost : null;
}
