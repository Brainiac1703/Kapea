@page "/profiles"
@inject KapeaApiClient Api
@inject IDialogService Dialogs
@inject IToastService Toasts

<PageTitle>@Ui["Profiles_Title"]</PageTitle>

<FluentLabel Typo="Typography.PageTitle">@Ui["Profiles_Heading"]</FluentLabel>
<FluentLabel Typo="Typography.Body" Class="intro">@Ui["Profiles_Intro"]</FluentLabel>

<FluentToolbar>
    <FluentButton Appearance="Appearance.Accent"
                  IconStart="@(new Icons.Regular.Size16.Add())"
                  Disabled="@(_platforms.Count == 0)"
                  OnClick="CreateAsync">
        @Ui["Profiles_New"]
    </FluentButton>
</FluentToolbar>

@if (_profiles is null)
{
    <FluentProgressRing />
}
else if (_profiles.Count == 0)
{
    <FluentMessageBar Intent="MessageIntent.Warning">@Ui["Profiles_Empty"]</FluentMessageBar>
}
else
{
    <FluentDataGrid Items="@_profiles.AsQueryable()" TGridItem="ImportProfileResponse" GridTemplateColumns="2fr 1fr 1fr 1fr auto">
        <PropertyColumn Property="@(profile => profile.Name)" Title="@Ui["Common_Name"]" />
        <PropertyColumn Property="@(profile => profile.Platform)" Title="@Ui["Common_Platform"]" />
        <TemplateColumn Title="@Ui["Profiles_CurrentVersion"]">@context.CurrentVersion</TemplateColumn>
        <TemplateColumn Title="@Ui["Common_Origin"]">
            @(context.BuiltIn ? Ui["Platforms_BuiltIn"] : Ui["Platforms_Added"])
        </TemplateColumn>
        <TemplateColumn Title="@Ui["Common_Actions"]" Align="Align.End">
            <FluentButton Appearance="Appearance.Stealth" OnClick="@(() => EditAsync(context))">
                @Ui["Profiles_Edit"]
            </FluentButton>
            @* Un perfil de serie se corrige, no se borra: el arranque lo volvería a crear. *@
            <FluentButton Appearance="Appearance.Stealth"
                          Disabled="@context.BuiltIn"
                          IconStart="@(new Icons.Regular.Size16.Delete())"
                          Title="@Ui["Common_Delete"]"
                          OnClick="@(() => DeleteAsync(context))" />
        </TemplateColumn>
    </FluentDataGrid>

    @if (_selected is { } detail)
    {
        <FluentLabel Typo="Typography.H5" Class="section">@detail.Name</FluentLabel>

        @if (detail.BuiltIn)
        {
            <FluentMessageBar Intent="MessageIntent.Info" AllowDismiss="false">@Ui["Profiles_BuiltInNote"]</FluentMessageBar>
        }

        <FluentDataGrid Items="@detail.Versions.AsQueryable()"
                        TGridItem="ImportProfileVersionResponse"
                        GridTemplateColumns="auto 1fr 2fr">
            <TemplateColumn Title="@Ui["Profiles_Version"]">@context.Number</TemplateColumn>
            <TemplateColumn Title="@Ui["Common_Date"]">@context.CreatedAt.ToLocalTime().ToString("g")</TemplateColumn>
            <TemplateColumn Title="@Ui["Profiles_Headers"]">@string.Join("; ", context.RecognizedHeaders)</TemplateColumn>
        </FluentDataGrid>
    }
}

@code {
    private IReadOnlyList<ImportProfileResponse>? _profiles;
    private IReadOnlyList<ImportFieldResponse> _fields = [];
    private IReadOnlyList<PlatformResponse> _platforms = [];
    private ImportProfileResponse? _selected;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _fields = await Api.GetImportFieldsAsync();
            _platforms = [.. (await Api.GetPlatformsAsync()).Where(platform => platform.ImportKind == "File")];
        }
        catch (KapeaApiException exception)
        {
            Toasts.ShowApiError(exception);
        }

        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        try
        {
            _profiles = await Api.GetProfilesAsync();
            _selected = _selected is null
                ? null
                : _profiles.FirstOrDefault(profile => profile.Id == _selected.Id);
        }
        catch (KapeaApiException exception)
        {
            _profiles = null;
            Toasts.ShowApiError(exception);
        }
    }

    private async Task CreateAsync()
    {
        var reglas = new ProfileRulesModel
        {
            AvailableFields = _fields,
            Platform = _platforms.FirstOrDefault()?.Code ?? string.Empty,
        };

        if (await AskAsync(reglas, Ui["Profiles_New"], Ui["Common_Add"]) is not { } filled)
        {
            return;
        }

        try
        {
            var created = await Api.CreateProfileAsync(
                new CreateImportProfileRequest(filled.Platform, filled.Name, filled.ToRequest()));

            Toasts.ShowSuccess(created.Name);
            _selected = created;
            await ReloadAsync();
        }
        catch (KapeaApiException exception)
        {
            Toasts.ShowApiError(exception);
        }
    }

    private async Task EditAsync(ImportProfileResponse profile)
    {
        _selected = profile;

        var version = profile.Versions.First(entry => entry.Number == profile.CurrentVersion);
        var reglas = ProfileRulesModel.From(profile, version, _fields);

        if (await AskAsync(reglas, Ui["Profiles_EditTitle"], Ui["Profiles_Save"]) is not { } filled)
        {
            return;
        }

        try
        {
            var revised = await Api.ReviseProfileAsync(
                profile.Id, new ReviseImportProfileRequest(filled.Name, filled.ToRequest()));

            Toasts.ShowSuccess($"{revised.Name} · {Ui["Profiles_Version"]} {revised.CurrentVersion}");
            _selected = revised;
            await ReloadAsync();
        }
        catch (KapeaApiException exception)
        {
            Toasts.ShowApiError(exception);
        }
    }

    private async Task<ProfileRulesModel?> AskAsync(ProfileRulesModel rules, string title, string confirm)
    {
        var dialog = await Dialogs.ShowDialogAsync<ProfileRulesDialog, ProfileRulesModel>(
            rules,
            new DialogParameters<ProfileRulesModel>
            {
                Content = rules,
                Title = title,
                PrimaryAction = confirm,
                SecondaryAction = Ui["Common_Cancel"],
                PreventDismissOnOverlayClick = true,
                Width = "640px",
            });

        var result = await dialog.Result;

        return result.Cancelled || result.Data is not ProfileRulesModel filled || !filled.IsComplete
            ? null
            : filled;
    }

    private async Task DeleteAsync(ImportProfileResponse profile)
    {
        var confirmation = await Dialogs.ShowConfirmationAsync(
            Ui["Profiles_DeleteConfirm_Message"],
            Ui["Common_Delete"],
            Ui["Common_Cancel"],
            $"{Ui["Profiles_DeleteConfirm_Title"]}: {profile.Name}");

        if ((await confirmation.Result).Cancelled)
        {
            return;
        }

        try
        {
            await Api.DeleteProfileAsync(profile.Id);
            _selected = null;
            await ReloadAsync();
        }
        catch (KapeaApiException exception)
        {
            Toasts.ShowApiError(exception);
        }
    }
}
