@inherits LayoutComponentBase

@implements IDisposable
@inject SessionState Session
@inject NavigationManager Navigation
@inject BodyFont BodyFont
@inject NeutralBaseColor NeutralBaseColor
@inject LayerCornerRadius LayerCornerRadius

@* El modo sigue al sistema, igual que la hoja de estilos: si Fluent pintara claro con
   la página en oscuro, los componentes y el fondo no casarían. *@
<FluentDesignTheme Mode="DesignThemeModes.System" CustomColor="@AccentColor" StorageName="kapea-theme" />

<FluentLayout>
    <FluentHeader Class="app-header">
        <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" Width="100%">
            <a class="brand" href="">
                <BrandMark />
                <span class="brand-name">@Ui["App_Wordmark"]</span>
            </a>
            <FluentSpacer />
            @if (Session.User is { } usuario)
            {
                <span class="session-user">
                    <span class="avatar" aria-hidden="true">@Initials(usuario.DisplayName)</span>
                    @usuario.DisplayName
                </span>
                <FluentButton Appearance="Appearance.Stealth" OnClick="SignOut">@Ui["Session_SignOut"]</FluentButton>
            }
        </FluentStack>
    </FluentHeader>

    <FluentStack Class="main" Orientation="Orientation.Horizontal" Width="100%">
        @* El menú solo aparece con sesión: sin ella todos sus destinos devuelven al
           acceso, y ofrecer puertas que no abren se lee como que algo va mal. *@
        @if (Session.IsSignedIn)
        {
            <NavMenu />
        }

        <FluentBodyContent Class="body-content">
            <div class="content">
                @Body
            </div>
        </FluentBodyContent>
    </FluentStack>
</FluentLayout>

@* Proveedores de Fluent UI: sin ellos los diálogos y los mensajes no tienen dónde
   pintarse y las acciones fallan en silencio. Van una sola vez, en el layout. *@
@code {
    /// <summary>Petróleo de la marca. Fluent deriva de él los tonos de cada estado y modo.</summary>
    private const string AccentColor = "#0e5e6a";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        // Neutros con un punto cálido, a juego con el fondo de la página: los grises
        // fríos de Fluent sobre un papel cálido se ven sucios.
        await NeutralBaseColor.WithDefault("#78766f");
        await BodyFont.WithDefault("\"IBM Plex Sans\", \"Segoe UI\", system-ui, sans-serif");
        await LayerCornerRadius.WithDefault(8);
    }

    /// <summary>
    /// Iniciales para el círculo de la cabecera.
    /// </summary>
    /// <remarks>
    /// Las dos primeras palabras, o la primera letra si el nombre es una sola. Un nombre
    /// vacío deja el círculo sin letras antes que inventarse unas.
    /// </remarks>
    public static string Initials(string? displayName)
    {
        var words = (displayName ?? string.Empty)
            .Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

        return string.Concat(words.Take(2).Select(word => char.ToUpper(word[0], System.Globalization.CultureInfo.CurrentCulture)));
    }

    protected override async Task OnInitializedAsync()
    {
        Session.Changed += StateHasChanged;

        await Session.EnsureLoadedAsync();

        // Sin sesión no hay nada que enseñar: la aplicación entera son datos de alguien.
        if (!Session.IsSignedIn && !EstaEnAcceso)
        {
            Navigation.NavigateTo("signin", forceLoad: false);
        }

        // Y con sesión, la pantalla de acceso no tiene nada que ofrecer: quien vuelve a
        // ella desde un enlace guardado esperaría entrar, no que le pidan entrar otra vez.
        if (Session.IsSignedIn && EstaEnAcceso)
        {
            Navigation.NavigateTo(string.Empty, forceLoad: false);
        }
    }

    private bool EstaEnAcceso =>
        Navigation.ToBaseRelativePath(Navigation.Uri).StartsWith("signin", StringComparison.OrdinalIgnoreCase);

    private void SignOut()
    {
        Session.Clear();

        // Navegación completa: la sesión vive en una cookie del servidor, y cerrarla es
        // cosa suya. El enrutador del cliente no la puede tocar.
        Navigation.NavigateTo("auth/signout-redirect", forceLoad: true);
    }

    public void Dispose() => Session.Changed -= StateHasChanged;
}

<FluentToastProvider />
<FluentDialogProvider />
<FluentTooltipProvider />
