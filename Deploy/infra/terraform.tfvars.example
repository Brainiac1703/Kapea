# Copia este fichero a terraform.tfvars y pon tu suscripción.
# terraform.tfvars está excluido del repositorio a propósito.
subscription_id = "00000000-0000-0000-0000-000000000000"

# Con false solo se crean el grupo de recursos y Azure OpenAI, que es lo que
# hace falta para desarrollar en local. Con true se añade la aplicación.
deploy_app = false
